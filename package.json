{
	"name": "zinn-seo",
	"version": "0.9.2",
	"private": true,
	"description": "Build tooling for the Zinn® SEO WordPress plugin's admin screens.",
	"license": "GPL-2.0-or-later",
	"author": "Neil Lock — CEO, Zinn Digital® Ltd",
	"engines": {
		"node": ">=24.18.1"
	},
	"prettier": "@wordpress/prettier-config",
	"scripts": {
		"build": "wp-scripts build",
		"start": "wp-scripts start",
		"lint-js": "wp-scripts lint-js src --ignore-pattern 'src/admin-kit/**' && cd ../../packages/zinn-admin-kit && ../../plugins/zinn-seo/node_modules/.bin/wp-scripts lint-js src/js --config wp-scripts-eslint.config.cjs",
		"test-unit-js": "wp-scripts test-unit-js"
	},
	"dependencies": {
		"@wordpress/api-fetch": "7.55.0",
		"@wordpress/components": "40.1.0",
		"@wordpress/compose": "8.9.0",
		"@wordpress/data": "10.56.0",
		"@wordpress/dom-ready": "4.56.0",
		"@wordpress/element": "8.7.0",
		"@wordpress/i18n": "6.28.0"
	},
	"devDependencies": {
		"@wordpress/scripts": "36.1.0",
		"jsdom": "30.1.2",
		"vite": "8.3.4",
		"vitest": "5.0.3"
	},
	"overrides": {
		"copy-webpack-plugin": {
			"serialize-javascript": "7.1.2"
		},
		"sockjs": {
			"uuid": "14.0.2"
		},
		"markdownlint-cli": {
			"js-yaml": "5.4.2"
		},
		"postcss-selector-parser": "7.1.6",
		"smol-toml": "1.9.1",
		"shell-quote": "1.12.0",
		"source-map-js": "1.2.2",
		"micromark-extension-math": {
			"katex": "0.18.2"
		}
	}
}
